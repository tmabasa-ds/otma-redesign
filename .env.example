# Supabase project connection (server-side only, never exposed to the browser).
# Find these under Project Settings > API in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: where new quote requests get pushed as a message the moment
# someone submits the wizard. Any of these work without further code changes:
#   - Slack incoming webhook URL (posts {"text": "..."})
#   - Make.com / Zapier catch hook that forwards to email or WhatsApp
# Leave empty to skip notifications; quotes will still save to Supabase.
QUOTE_NOTIFY_WEBHOOK_URL=

# Optional endpoint override for the OpenStreetMap-compatible geocoder.
# Address search is triggered by the user; typing the full address remains available.
OPENSTREETMAP_GEOCODING_URL=https://nominatim.openstreetmap.org/search
OPENSTREETMAP_USER_AGENT=On The Move Again address search (sales@otma.co.za)
